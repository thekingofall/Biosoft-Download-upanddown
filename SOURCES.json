  "integration_notes": [
    "Original git histories retained in local verified git bundles by the owner.",
    "Public import uses source snapshots; embedded private credential removed.",
    "Launcher, README and module dependency files added.",
    "Personal deployment paths replaced with configurable defaults.",
    "Aspera relative paths, argv execution and failure exits corrected.",
    "Synapse CLI arguments, recursive errors and path validation added.",
    "Novogene missing imports, subprocess argv and process-wide directory changes corrected.",
    "Legacy Synapse download list now reads the SDK CSV manifest with file IDs and versions; list entries remain intact.",
    "Novogene MD5 failures now prevent successful task completion."
  ]
